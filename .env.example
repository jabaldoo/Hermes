# HERMES - konfiguracja demonstratora (skopiuj do .env)

# Tryb anonimizacji twarzy na pokladzie drona: blur | pixel | black
ANON_MODE=blur

# 1 = pobieraj realne dane (IMGW live, Copernicus EMS); 0 = tylko dane lokalne (pokaz offline)
UZYWAJ_REALNYCH_ZRODEL=1

# Opcjonalna sciezka bazy SQLite (domyslnie hermes.db w katalogu projektu)
# HERMES_DB=C:\sciezka\hermes.db
